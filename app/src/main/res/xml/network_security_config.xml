<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloquear tráfico HTTP plano — solo HTTPS permitido -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Configuración específica para dominios de Spotify -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">spotify.com</domain>
        <domain includeSubdomains="true">spotifycdn.com</domain>
        <domain includeSubdomains="true">scdn.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>

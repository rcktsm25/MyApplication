<resources>
<style name="ClassicButton" parent="Widget.AppCompat.Button">
<item name="android:background">@drawable/winamp_button_bg</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item>
<item name="android:textColor">#172534</item><item name="android:textSize">10sp</item><item name="android:textStyle">bold</item><item name="android:fontFamily">monospace</item>
<item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item><item name="android:padding">4dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item><item name="android:singleLine">true</item>
</style>
<style name="ClassicIcon" parent="Widget.AppCompat.ImageButton">
<item name="android:background">@drawable/winamp_button_bg</item><item name="android:padding">10dp</item><item name="android:scaleType">fitCenter</item><item name="tint">#192734</item>
</style>
<style name="ClassicLabel"><item name="android:fontFamily">monospace</item><item name="android:textColor">#C8C8D7</item><item name="android:textSize">9sp</item><item name="android:singleLine">true</item></style>
<style name="ClassicSlider"><item name="android:progressDrawable">@drawable/winamp_seekbar_progress</item><item name="android:thumb">@drawable/winamp_thumb</item><item name="android:splitTrack">false</item><item name="android:minHeight">8dp</item><item name="android:maxHeight">8dp</item></style>
</resources>

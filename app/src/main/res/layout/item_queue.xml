<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:background="@drawable/pro_track_row">

    <TextView
        android:id="@+id/queue_number"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="#B6EE65"
        android:gravity="center"
        android:text="01"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/queue_title"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#B6EE65"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/queue_artist"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:fontFamily="sans-serif"
            android:textSize="9sp"
            android:textColor="#9CAAB7"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/queue_duration"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="9sp"
        android:textColor="#869978"
        android:gravity="end"
        android:text="3:45"/>

    <ImageButton
        android:id="@+id/btn_remove_queue"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="fitCenter"
        app:tint="#6B7B8B"
        android:contentDescription="Eliminar de la cola"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de carga con efecto Shimmer para listas de canciones
     Se muestra mientras se cargan las canciones de Spotify o la biblioteca local
     Efecto de brillo profesional como Facebook/Instagram -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1500"
    app:shimmer_repeat_mode="restart">

    <!-- Skeleton de carga profesional -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fila de carga 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/player_screen"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="40dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/player_screen"/>
        </LinearLayout>

        <!-- Fila de carga 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/player_screen"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="40dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/player_screen"/>
        </LinearLayout>

        <!-- Fila de carga 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/player_screen"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/player_screen"/>

            <View
                android:layout_width="40dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/player_screen"/>
        </LinearLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queue_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/winamp_title_strip"
        android:tag="classic_strip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="10dp"
            android:background="#282936"
            android:tag="classic_title"
            android:text="COLA DE REPRODUCCIÓN"
            android:textColor="#E0E2EA"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:accessibilityHeading="true"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_clear_queue"
            style="@style/PanelButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Limpiar cola"
            android:textSize="11sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_shuffle_queue"
            style="@style/PanelButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Aleatorio"
            android:textSize="11sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_queue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:background="@drawable/player_screen"
        android:paddingTop="4dp"
        android:scrollbars="vertical"/>

    <TextView
        android:id="@+id/queue_message"
        style="@style/PlayerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:gravity="center"
        android:text="La cola está vacía"
        android:textSize="11sp"/>
</LinearLayout>

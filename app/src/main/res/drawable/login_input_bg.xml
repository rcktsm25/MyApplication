<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/rocket_bg_dark" />
            <stroke android:width="2dp" android:color="@color/rocket_accent" />
            <corners android:radius="3dp" />
            <padding android:bottom="8dp" android:left="12dp" android:right="12dp" android:top="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/rocket_display_bg" />
            <stroke android:width="1dp" android:color="@color/rocket_accent_dim" />
            <corners android:radius="3dp" />
            <padding android:bottom="8dp" android:left="12dp" android:right="12dp" android:top="8dp" />
        </shape>
    </item>
</selector>
